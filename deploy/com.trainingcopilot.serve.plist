<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job to keep Training Copilot serving across logins/reboots/crashes.

  Install (edit the __PLACEHOLDERS__ first — see docs/deploy-macmini.md):
    cp deploy/com.trainingcopilot.serve.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.trainingcopilot.serve.plist
    launchctl start com.trainingcopilot.serve
  Logs: /tmp/training-copilot.serve.out / .err   ·   Stop: launchctl unload -w ~/Library/LaunchAgents/com.trainingcopilot.serve.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trainingcopilot.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/run.sh</string>
    <string>prod</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- python interpreter; PATH must include node/npm. Leave PY unset to use .venv -->
    <key>PY</key><string>__PY__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- build once by hand, then let the service reuse web/dist for fast restarts -->
    <key>SKIP_BUILD</key><string>1</string>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>3000</string>
    <!-- uncomment so the service also brings up the public Tailscale Funnel:
    <key>FUNNEL</key><string>1</string> -->
    <!-- uncomment to require a shared PIN in front of everything (public URLs):
    <key>DO_LOCK</key><string>true</string>
    <key>APP_PIN</key><string>__LONG_PASSPHRASE__</string>
    <key>AUTH_SECRET</key><string>__RANDOM_HEX__</string> -->
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/training-copilot.serve.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/training-copilot.serve.err</string>
</dict>
</plist>
