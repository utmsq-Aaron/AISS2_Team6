# ── Strava OAuth2 ─────────────────────────────────────────────────────────────
# Get from https://www.strava.com/settings/api
# Note: Strava API requires a paid subscription since May 2025.
# The app works without Strava — Garmin, Weather and Routes remain fully functional.
CLIENT_ID=your_strava_client_id
CLIENT_SECRET=your_strava_client_secret

# Public origin the browser reaches this app on. Behind the Tailscale funnel set it
# to https://training-copilot.taildb0702.ts.net; used to build the OAuth redirect URIs
# (Strava + Google callbacks). Leave as-is for local dev.
PUBLIC_BASE_URL=http://localhost:8000
# Override only if the Strava callback lives at a non-default URL. The Strava app
# (strava.com/settings/api) Authorization Callback Domain must equal the HOST of
# PUBLIC_BASE_URL — Strava allows only one.
# STRAVA_OAUTH_REDIRECT=

# ── LLM provider ──────────────────────────────────────────────────────────────
# Which provider the app uses:
#   openai (KIT / any OpenAI-compatible endpoint, default) | openai_official (api.openai.com) | gemini
LLM_PROVIDER=openai

# ── LLM: OpenAI-compatible (KIT Gateway) ──────────────────────────────────────
# KIT students: get your key from the Übungsleitung / DSI portal
# Available models: kit.gpt-4.1, kit.gpt-5, kit.gpt-5-mini, meta-llama-3.1-8b-instruct
OPENAI_API_KEY=your_kit_api_key
OPENAI_BASE_URL=https://ai-gateway.dsi-experimente.de/v1
AGENT_MODEL=kit.gpt-4.1
# Optional: a dedicated (stable) model for the multi-call agent layer; falls back to AGENT_MODEL
AGENT_LLM_MODEL=kit.gpt-4.1

# Peer-to-peer mesh between the specialists (a specialist may consult another).
# AGENT_MESH=0                      # off entirely — specialists only answer for themselves
# AGENT_MAX_PEER_DEPTH=2            # a consulted peer may not re-delegate (rules out cycles)
# AGENT_MESH_EXCLUDE=recovery       # take single agents out of the mesh, comma-separated

# ── LLM: Official OpenAI (when LLM_PROVIDER=openai_official) ───────────────────
# Real OpenAI key from https://platform.openai.com/api-keys
OPENAI_OFFICIAL_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional: only for Azure/proxy; blank = https://api.openai.com/v1
OPENAI_OFFICIAL_BASE_URL=

# ── LLM: Google Gemini (when LLM_PROVIDER=gemini) ─────────────────────────────
# Free key at https://aistudio.google.com/apikey (needs free-tier quota enabled on the project)
GEMINI_API_KEY=your_gemini_api_key
# Free flash models: gemini-2.0-flash, gemini-2.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.0-flash

# ── Garmin Connect ────────────────────────────────────────────────────────────
# Optional — enables the Health page and Garmin activity data in Chat
# Option A: use real credentials (run auth/garmin_setup.py once to cache tokens)
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Option B: use mock data (no real device/account needed — toggle in Settings)
GARMIN_MOCK_HEALTH=false

# ── OpenRouteService ──────────────────────────────────────────────────────────
# Optional — enables route planning (plan_route, explore_trails, isochrone)
# Free key at https://openrouteservice.org/dev/#/signup (2 000 req/day, no credit card)
ORS_API_KEY=your_ors_api_key

# ── Telegram (optional) ───────────────────────────────────────────────────────
# Bridges the external stdio server github.com/chigwell/telegram-mcp onto this app
# via servers/telegram_mcp.py (proxy). Upstream is vendored in ./external/telegram-mcp.
# API_ID / API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
# Generate ONCE (interactive — login is disabled when run as a server), then paste here:
#   uv run --directory external/telegram-mcp session_string_generator.py
TELEGRAM_SESSION_STRING=your_telegram_session_string
# Optional: expose only read tools — TELEGRAM_EXPOSED_TOOLS=read-only

# ── Telegram agent bridge (optional) ──────────────────────────────────────────
# Chat with the agent from Telegram: `python telegram_bridge.py` runs a userbot
# that forwards every incoming message to the agent and replies (with route maps).
# Reuses TELEGRAM_API_ID/HASH + TELEGRAM_SESSION_STRING above by default.
# TELEGRAM_ALLOWED_USERS=          # comma-separated user IDs / @usernames; empty = anyone
# TELEGRAM_BRIDGE_ALLOW_GROUPS=false   # true → also answer in group chats (default: DMs only)
# TELEGRAM_BRIDGE_HISTORY=10           # turns of context kept per chat
# Only needed to run the bridge AND the telegram-mcp proxy at the same time
# (avoids AuthKeyDuplicated). Make one with: python telegram_bridge.py --login
# TELEGRAM_BRIDGE_SESSION_STRING=
#
# Voice memos sent to the bridge are transcribed locally with Whisper (de/en, auto).
# WHISPER_MODEL=small    # tiny|base|small|medium|large-v3 — bigger = better German, slower
# WHISPER_BACKEND=       # mlx|faster|openai (default: auto — mlx on Apple Silicon w/ ffmpeg, else faster)
# WHISPER_LANGUAGE=      # force a language e.g. de/en (default: auto-detect)

# ── Google Calendar ───────────────────────────────────────────────────────────
# Optional — enables calendar integration for the coach and Chat
# Create credentials at https://console.cloud.google.com/apis/credentials
# To connect the admin Gmail sender, enable the Gmail API and run:
#   python auth/google_oauth.py
# This creates .tokens/google_mail.json (gmail.send for OTP/feedback email).
# The regular Google Calendar connect flow uses the same client ID/secret in-app,
# but it additionally needs the Calendar API and stores .tokens/google.json.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Set to false to skip the Gmail/Google onboarding page and open the regular app
# shell immediately; the onboarding flow stays available in the code.
VITE_SHOW_GMAIL_REGISTRATION_PAGE=false
# Set this for local development to skip the email OTP page entirely and land
# directly in the app as a shared dev account.
# VITE_DEV_AUTO_LOGIN_EMAIL=kit.aiss2026@gmail.com
# Override only if the Google callback lives at a non-default URL. When deployed
# behind a public host, set this to the public callback URL AND register it as an
# Authorized redirect URI in the Google Cloud Console. ALSO publish the OAuth
# consent screen to "In production": in "Testing" status Google expires refresh
# tokens after 7 days, which forces recurring interactive 2FA re-auth.
# GOOGLE_OAUTH_REDIRECT=https://training-copilot.taildb0702.ts.net/api/settings/google/callback

# ── Access gate (required before exposing the app publicly) ───────────────────
# DO_LOCK=true puts a shared passphrase in front of the whole app (the Node BFF
# checks it). APP_PIN is that passphrase — a real secret, so choose a long one,
# keep it out of any committed file, and rotate it if it ever leaks.
# AUTH_SECRET signs the login tokens; without it they are signed with a public
# dev fallback and can be FORGED. Generate: openssl rand -hex 32
DO_LOCK=false
# APP_PIN=choose-a-long-passphrase
# AUTH_SECRET=

# ── MLflow tracing (optional) ─────────────────────────────────────────────────
# The agent layer (orchestrator + specialists) and the chart service trace every
# LLM / tool call to an MLflow server. ./run.sh starts that
# server on :5001 for you — open http://localhost:5001 to browse the traces.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=fitdash
# Set to 0/false/off to turn tracing off entirely (the app still runs).
MLFLOW_TRACING=1

# ── Google Geocoding (optional) ───────────────────────────────────────────────
# Enables the routes "geocode" tool (place name → coordinates, Geocoding API v4),
# so the route agent can anchor loops/routes at named places (e.g. "Schlossgarten")
# instead of the home coordinate. Usually unnecessary: GOOGLE_MAPS_API_KEY below is
# used as the fallback, so one Maps Demo Key covers both. Set this only to use a
# separate key for geocoding.
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# ── Google Maps MCP (optional) ────────────────────────────────────────────────
# Enables the google_maps MCP server (servers/google_maps_mcp.py) — a native
# FastMCP server against Google's current APIs: Places API (New) for POI search
# and details, Geocoding API v4, and the Routes API for directions/ETA in Chat.
# A billing-free Maps Demo Key works (https://mapsplatform.google.com/maps-demo-key/
# — no credit card; user reviews/photos are not served on demo keys).
# Also used as a fallback key for the routes "geocode" tool above (same v4 API).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Fitness Expert agent — local RAG (optional) ───────────────────────────────
# The fitness specialist (:9005) retrieves from a local vector DB of public-domain
# fitness books using a small LOCAL embedding model — no API key needed. Defaults
# are fine; override only to change the model, device, or index location.
# FITNESS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FITNESS_EMBED_DEVICE=mps        # auto-detected (mps → cuda → cpu); set to force
# FITNESS_INDEX_DIR=data/fitness_library/index

# ── Personal coach: proactivity + deep analysis (optional) ────────────────────
# The coach schedules its own proactive check-ins; the durable poll loop runs in
# the Telegram bridge (the only always-on process). Proactivity is paused when the
# bridge is not running. All values below are sensible defaults — override to tune.
# SCHEDULE_POLL_SECONDS=60        # how often the bridge checks for due wake-ups
# CAL_SCAN_SECONDS=3600           # how often it auto-schedules from the calendar
# CAL_PRE_OFFSET_MIN=60           # pre-event nudge, minutes before a calendar event
# CAL_POST_OFFSET_MIN=30          # post-event follow-up, minutes after it ends
# DAILY_CHECKIN_HOUR=9            # local (Europe/Berlin) hour for the daily buddy check-in
# DAILY_CHECKIN_SKIP_HOURS=8      # skip today's check-in if the user chatted more recently than this
# Deep analysis (long background jobs, triaged by the orchestrator):
# DEEP_RECURSION_LIMIT=60         # LangGraph step budget for a deep job (default 25)
# DEEP_JOB_TIMEOUT=600            # wall-clock seconds before a deep job is aborted
# DEEP_MAX_CONCURRENT=2           # max deep jobs running at once (gateway load cap)
# Goal panels (each goal's agent-authored dashboard content, core/goal_panel.py):
# GOAL_BUILD_POLL_SECONDS=5       # how often the bridge drains form-created/refreshed builds
# GOAL_PANEL_STALE_HOURS=20       # panels older than this are re-enqueued by the hourly scan
# GOAL_PANEL_RECURSION_LIMIT=30   # LangGraph step budget for one panel build
# GOAL_PANEL_TIMEOUT=180          # wall-clock seconds before a panel build is aborted
# GOAL_PANEL_MAX_CONCURRENT=3     # max panel builds running at once (gateway load cap)

# ── Admin + feedback (optional) ────────────────────────────────────────────────
# The single admin account (settings/env editing, and the recipient of feedback
# notifications + the only one who can list/download feedback bundles).
# Unset means NOBODY is admin (fail closed) — set it to the admin Gmail account,
# i.e. the same one authorized via auth/google_oauth.py.
# ADMIN_EMAIL=kit.aiss2026@gmail.com
# The red feedback button (web UI) captures a diagnostic bundle to data/feedback/
# and best-effort emails ADMIN_EMAIL a short notification (text + bundle id only —
# never the bundle) via the same Gmail sender used for OTP login (api/email_service.py);
# silently skipped if Google/Gmail isn't connected. No extra config needed here.
